{
  "name": "travel-manager",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered end-to-end travel manager (MERN + Gemini + Geoapify + Leaflet)",
  "scripts": {
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "import:data": "NODE_PATH=server/node_modules node scripts/importDatasets.js",
    "import:overture": "NODE_PATH=server/node_modules node scripts/importDatasets.js overture_pois",
    "build:pois": "node scripts/run_python.js scripts/build_poi_dataset.py",
    "build:pois:fast": "node scripts/run_python.js scripts/build_poi_dataset.py --skip-wikidata",
    "create:indexes": "NODE_PATH=server/node_modules node scripts/createIndexes.js",
    "check:maps": "node scripts/check_no_google_maps.js",
    "test": "node --test tests/backend/*.test.js",
    "setup:server": "npm install --prefix server",
    "setup:client": "npm install --prefix client",
    "setup": "npm run setup:server && npm run setup:client"
  },
  "license": "UNLICENSED"
}
