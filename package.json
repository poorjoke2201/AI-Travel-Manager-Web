{
  "name": "travel-manager",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered end-to-end travel manager (MERN + Gemini + Google Maps + Leaflet)",
  "scripts": {
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "import:data": "NODE_PATH=server/node_modules node scripts/importDatasets.js",
    "create:indexes": "NODE_PATH=server/node_modules node scripts/createIndexes.js",
    "setup:server": "npm install --prefix server",
    "setup:client": "npm install --prefix client",
    "setup": "npm run setup:server && npm run setup:client"
  },
  "license": "UNLICENSED"
}